# SPDX-License-Identifier: MIT
# The base is the already validated, immutable B12X Vision candidate image.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION
ARG EXPECTED_QUANT_CONFIG_SHA256
ARG EXPECTED_VL_MODEL_SHA256
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"
LABEL org.opencontainers.image.licenses="MIT AND Apache-2.0 AND BSD-3-Clause"
COPY scripts/patch-b12x-mixed-quant.py /opt/dsv4-vision/patch-b12x-mixed-quant.py
COPY overlay/vllm/models/deepseek_v4/mixed_expert_quant.py \
  /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/mixed_expert_quant.py
RUN test "$(sha256sum /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/nvidia/vl_model.py | cut -d' ' -f1)" = "${EXPECTED_VL_MODEL_SHA256}" && \
    python3 /opt/dsv4-vision/patch-b12x-mixed-quant.py \
      --expected-sha256 "${EXPECTED_QUANT_CONFIG_SHA256}" && \
    python3 -m py_compile \
      /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/quant_config.py \
      /usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/mixed_expert_quant.py
COPY LICENSE NOTICE CREDITS.md /usr/share/licenses/dspark-vllm-gx10/
COPY LICENSES/ /usr/share/licenses/dspark-vllm-gx10/
